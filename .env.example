# Supabase Configuration
# Get these values from your Supabase project dashboard
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Environment
EXPO_PUBLIC_ENV=development

# App Configuration
EXPO_PUBLIC_APP_VERSION=1.0.0

# Dev auto sign-in (optional, dev builds only). While the login screens are bypassed there is no
# session, so saving to Supabase fails with "Not authenticated". Put a real account here — in
# .env.local (gitignored), NOT in a tracked file — and restart `expo start` after changing it.
# EXPO_PUBLIC_DEV_EMAIL=you@example.com
# EXPO_PUBLIC_DEV_PASSWORD=your-password
