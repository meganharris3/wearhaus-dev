# The dependency tree has known peer mismatches (Expo SDK 56 expects react 19.2.3 /
# react-native 0.85.x; this project pins react 19.1.0 / react-native 0.86). The lockfile was
# generated with legacy peer resolution, so installs must use it too, or `npm ci` fails with ERESOLVE.
legacy-peer-deps=true
